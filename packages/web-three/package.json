  },
  "dependencies": {
    "@anthroforge/web": "file:../web"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "esbuild": "^0.24.0",
    "three": "^0.186.0",
    "typescript": "^5.6.0"
  }
}
